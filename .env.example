# ===== WhatsApp (Meta for Developers) =====
WHATSAPP_TOKEN=            # token permanente do usuário do sistema (System User)
WHATSAPP_APP_SECRET=       # App > Configurações > Básico > Chave secreta do app
WHATSAPP_VERIFY_TOKEN=     # qualquer frase que você inventar; a mesma vai no painel da Meta
WHATSAPP_GRAPH_VERSION=v23.0

# Um número para cada negócio (WhatsApp > Configuração da API > "Identificação do número de telefone")
GIVANCE_PHONE_NUMBER_ID=
ELITE_PHONE_NUMBER_ID=

# Quem recebe o aviso de lead quente (com DDI, sem +): 5561996747738
GIVANCE_DONO_WHATSAPP=5561996747738
ELITE_DONO_WHATSAPP=

# Só se a equipe NÃO responde pelo mesmo número do agente: WhatsApp que o agente passa ao cliente
GIVANCE_CONTATO_HUMANO=
ELITE_CONTATO_HUMANO=

# Template aprovado para avisar o dono (opcional, recomendado). Ver README.
WHATSAPP_TEMPLATE_AVISO=
WHATSAPP_TEMPLATE_IDIOMA=pt_BR

# ===== IA (OpenRouter) =====
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# ===== Banco (Supabase) =====
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ===== Ajustes =====
AGRUPAR_MS=3500   # espera para juntar mensagens seguidas do cliente
HORAS_PAUSA=12    # quanto tempo o agente fica quieto depois que um humano assume
