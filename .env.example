# ===== WhatsApp (Meta for Developers) =====
WHATSAPP_TOKEN=            # token da PLATAFORMA (usuário do sistema da Givance). Usado pelos números sem token próprio
WHATSAPP_APP_SECRET=       # App > Configurações > Básico > Chave secreta do app
WHATSAPP_VERIFY_TOKEN=     # qualquer frase que você inventar; a mesma vai no painel da Meta
WHATSAPP_GRAPH_VERSION=v23.0

# Template aprovado para avisar o dono, quando o número não tem um próprio (opcional, recomendado). Ver README.
WHATSAPP_TEMPLATE_AVISO=
WHATSAPP_TEMPLATE_IDIOMA=pt_BR

# ===== IA (OpenRouter) =====
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# ===== Banco (Supabase) =====
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Chave que cifra os tokens de WhatsApp dos clientes no banco. 32 bytes em base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Se perder ou trocar, os tokens salvos param de funcionar e os clientes precisam reconectar.
TOKEN_KEY=

# ===== Só para "npm run semear" (cadastra Givance e Elite Car a partir das fichas em lib/negocios/) =====
GIVANCE_WORKSPACE_ID=                 # id do workspace na tabela workspaces (do Givance Publi)
ELITE_WORKSPACE_ID=
GIVANCE_PHONE_NUMBER_ID=
ELITE_PHONE_NUMBER_ID=
GIVANCE_DONO_WHATSAPP=5561996747738   # quem recebe o aviso de lead quente (DDI, sem +)
ELITE_DONO_WHATSAPP=
GIVANCE_CONTATO_HUMANO=               # só se a equipe NÃO atende pelo mesmo número do agente
ELITE_CONTATO_HUMANO=

# ===== Ajustes =====
AGRUPAR_MS=3500   # espera para juntar mensagens seguidas do cliente
HORAS_PAUSA=12    # quanto tempo o agente fica quieto depois que um humano assume
